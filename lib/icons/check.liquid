{%- comment -%}
  Lucide icon: check
  Usage: {% render 'lib/icons/check', size: 14, stroke_width: 1.8 %}
{%- endcomment -%}
{%- liquid
  assign size = size | default: 24
  assign stroke_width = stroke_width | default: 1.5
-%}
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ size }}"
  height="{{ size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="{{ stroke_width }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="icon icon-check{% if class %} {{ class }}{% endif %}"
  aria-hidden="true"
  focusable="false"
>
  <path d="M20 6 9 17l-5-5" />
</svg>

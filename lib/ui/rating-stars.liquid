{% assign rating_value = rating | default: 0 | plus: 0 %}
{% if rating_value > 5 %}{% assign rating_value = 5 %}{% endif %}
{% if rating_value < 0 %}{% assign rating_value = 0 %}{% endif %}
{% assign review_count = count %}
{% assign fill_percentage = rating_value | times: 100.0 | divided_by: 5 %}
{% assign rating_label = rating_value | round: 1 %}
{% assign star_size = star_size | default: size | default: 14 %}
{% if star_size > 18 %}
  {% assign rating_size_class = 'rating--lg' %}
{% else %}
  {% assign rating_size_class = 'rating--sm' %}
{% endif %}

<div
  class="rating {{ rating_size_class }}"
  style="--rating-fill: {{ fill_percentage }}%;"
  aria-label="Calificación: {{ rating_label }} de 5{% if review_count != blank and review_count > 0 %} ({{ review_count }}){% endif %}"
>
  <span class="rating__stars">
    <span class="rating__background" aria-hidden="true">
      {% for i in (1..5) %}
        <svg class="rating__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ star_size }}" height="{{ star_size }}" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" />
        </svg>
      {% endfor %}
    </span>
    <span class="rating__fill" aria-hidden="true">
      {% for i in (1..5) %}
        <svg class="rating__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="{{ star_size }}" height="{{ star_size }}" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" />
        </svg>
      {% endfor %}
    </span>
  </span>
  {% if review_count != blank and review_count > 0 %}
    <span class="rating__count">{{ rating_label }} ({{ review_count }})</span>
  {% endif %}
</div>

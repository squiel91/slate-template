{% if info.totalPages > 1 %}
  {% capture extra %}{% if query.q != blank %}&amp;q={{ query.q | url_encode }}{% endif %}{% if query.sort != blank %}&amp;sort={{ query.sort | url_encode }}{% endif %}{% endcapture %}
  <nav class="pagination" aria-label="Paginación">
    {% if info.hasPreviousPage %}<a href="?page={{ info.currentPage | minus: 1 }}{{ extra }}" rel="prev" aria-label="Anterior">{% render 'icon-chevron-left', size: 16, stroke_width: 1.7 %}</a>{% endif %}
    {% assign first_page = info.currentPage | minus: 2 | at_least: 1 %}
    {% assign last_page = info.currentPage | plus: 2 | at_most: info.totalPages %}
    {% for number in (first_page..last_page) %}
      {% if number == info.currentPage %}<span aria-current="page">{{ number }}</span>{% else %}<a href="?page={{ number }}{{ extra }}">{{ number }}</a>{% endif %}
    {% endfor %}
    {% if info.hasNextPage %}<a href="?page={{ info.currentPage | plus: 1 }}{{ extra }}" rel="next" aria-label="Siguiente">{% render 'icon-chevron-right', size: 16, stroke_width: 1.7 %}</a>{% endif %}
  </nav>
{% endif %}

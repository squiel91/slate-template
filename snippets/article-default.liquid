<article class="page page-width prose-page">
  {% render 'breadcrumbs', parent_url: '/blog', parent_label: 'Blog', current_label: article.title %}
  <h1>{{ article.title | escape }}</h1>
  {% render 'article-byline', author: store.name, datetime: article.publishedAt %}
  {% if article.coverImage %}
    <span class="media media--wide">
      <img class="media__img" src="{{ article.coverImage.url | escape }}" alt="{{ article.coverImage.alt | default: article.title | escape }}">
    </span>
  {% endif %}
  {% if article.content and article.content.size > 0 %}
    <div class="prose">{% render 'content-blocks', blocks: article.content %}</div>
  {% endif %}
  <p>
    <a class="text-link" href="/blog">
      {% render 'icon-arrow-left', size: 16, stroke_width: 1.7 %}
      Volver al blog
    </a>
  </p>
</article>

<section class="section section--contrast newsletter-section" data-animate-in aria-labelledby="newsletter-heading-newsletter">
  <div class="page-width newsletter-block">
    {% if 'Novedades' != blank %}
      <span class="section-kicker">Novedades</span>
    {% endif %}
    <h2 class="section-title" id="newsletter-heading-newsletter">Novedades</h2>
    {% if 'Dejanos tu email y te contamos cuando haya novedades.' != blank %}
      <p class="newsletter-copy">Dejanos tu email y te contamos cuando haya novedades.</p>
    {% endif %}
    {% render 'newsletter-form', form_id: 'newsletter' %}
  </div>
</section>

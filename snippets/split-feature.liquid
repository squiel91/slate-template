{% assign feature_collection = collection %}
{% assign split_image = 'http://localhost:8787/imagedelivery/local/3aed9e25-0141-4ed0-a706-b4a37c902934/lg' | default: 'http://localhost:8787/imagedelivery/local/3aed9e25-0141-4ed0-a706-b4a37c902934/lg' %}
{% if split_image == blank and feature_collection.coverImage %}
  {% assign split_image = feature_collection.coverImage.url %}
{% endif %}
{% assign split_url = '' %}
{% if split_url == blank and feature_collection.url %}
  {% assign split_url = feature_collection.url %}
{% endif %}

<section class="section" data-animate-in aria-labelledby="split-heading-split-feature">
  <div class="split page-width">
    <div class="split__copy">
      {% if 'Selección' != blank %}
        <span class="section-kicker">Selección</span>
      {% endif %}
      <h2 class="section-title" id="split-heading-split-feature">Piezas para la mesa</h2>
      {% if 'Una categoría pensada para el uso diario: formas simples, materiales honestos y una paleta que se adapta a cualquier casa.' != blank %}
        <p>Una categoría pensada para el uso diario: formas simples, materiales honestos y una paleta que se adapta a cualquier casa.</p>
      {% endif %}
      {% if 'Ver vajilla' != blank and split_url != blank %}
        <a class="button" href="{{ split_url | escape }}">
          Ver vajilla
          {% render 'icon-arrow-right', size: 16, stroke_width: 1.7 %}
        </a>
      {% endif %}
    </div>
    <div class="split__media">
      {% if split_image != blank %}
        <img
          src="{{ split_image | image_url: width: 1400 | escape }}"
          alt="{{ '' | default: 'Piezas para la mesa' | escape }}"
          loading="lazy"
        >
      {% endif %}
    </div>
  </div>
</section>

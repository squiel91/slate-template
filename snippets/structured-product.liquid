{% assign product_url = store.url | append: product.url %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Product","name":{{ product.title | json | replace: '<', '\u003c' }},"url":{{ product_url | json | replace: '<', '\u003c' }},"description":{{ description | json | replace: '<', '\u003c' }}{% if product.coverImage %},"image":[{{ product.coverImage.url | json | replace: '<', '\u003c' }}]{% endif %},"brand":{"@type":"Brand","name":{{ store.name | json | replace: '<', '\u003c' }}}{% if product.price != nil %},"offers":{"@type":"Offer","priceCurrency":{{ product.currency | json | replace: '<', '\u003c' }},"price":{{ product.price | divided_by: 100.0 }},"availability":"https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}","url":{{ product_url | json | replace: '<', '\u003c' }}{% if product.compareAtPrice > product.price %},"priceSpecification":[{"@type":"UnitPriceSpecification","price":{{ product.compareAtPrice | divided_by: 100.0 }},"priceType":"https://schema.org/ListPrice"},{"@type":"UnitPriceSpecification","price":{{ product.price | divided_by: 100.0 }},"priceType":"https://schema.org/SalePrice"}]{% endif %}}{% endif %}{% if product.reviewsCount > 0 %},"aggregateRating":{"@type":"AggregateRating","ratingValue":{{ product.rating | round: 1 }},"reviewCount":{{ product.reviewsCount }}}{% endif %}}
</script>

<article class="product-card">
  {% if product.url %}<a href="{{ product.url }}">{% endif %}
    {% if product.coverImage %}<img src="{{ product.coverImage | image_url: width: 600 | escape }}" alt="{{ product.coverImage.alt | escape }}" width="600" loading="lazy">{% endif %}
    <h2>{{ product.title | escape }}</h2>
  {% if product.url %}</a>{% endif %}
  <p>{{ product.price | money: product.currency }}</p>
</article>

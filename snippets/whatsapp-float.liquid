{% assign wa_phone = shop.whatsappNumber | default: '59898155759' %}
{% assign wa_digits = wa_phone | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' %}
{% assign wa_label = 'Escribinos por WhatsApp' | default: 'Escribinos por WhatsApp' %}

{% assign wa_message = 'Hola! Vi su tienda online y tengo una consulta.' %}

<a
  class="whatsapp-float" data-whatsapp-contact
  href="https://wa.me/{{ wa_digits | escape }}?text={{ wa_message | strip | url_encode | escape }}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="{{ wa_label | escape }}"
>
  {% render 'icon-whatsapp', size: 20 %}
  <span>{{ wa_label | escape }}</span>
</a>

<section class="section section--compact shop-notes" data-animate-in aria-labelledby="shop-notes-heading-highlights">
  <div class="page-width">
    <h2 class="visually-hidden" id="shop-notes-heading-highlights">Antes de comprar</h2>
    {% if 'La compra' != blank %}
      <span class="section-kicker">La compra</span>
    {% endif %}
    <dl class="shop-notes__grid">
      <div>
        <dt>Envío a todo el país</dt>
        <dd>El costo se calcula al finalizar la compra, según tu ubicación.</dd>
      </div>
      <div>
        <dt>Cambios simples</dt>
        <dd>Revisá las políticas de la tienda antes de comprar.</dd>
      </div>
      <div>
        <dt>Pago seguro</dt>
        <dd>Completá tu pedido en un checkout protegido.</dd>
      </div>
    </dl>
  </div>
</section>

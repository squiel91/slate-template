{% assign reviews = product.reviews.nodes %}

<section class="product-reviews page-width" data-animate-in aria-labelledby="reviews-heading-product-reviews">
  <h2 id="reviews-heading-product-reviews">Reseñas</h2>
  {% if reviews.size > 0 %}
    <ol class="review-list">
      {% for review in reviews limit: 6 %}
        <li>
          <article>
            <div class="review-heading">
              <h3>{{ review.authorName | escape }}</h3>
              {% if review.verifiedPurchase %}
                <p class="review-verified">
                  {% render 'icon-check', size: 14, stroke_width: 2.75 %}
                  Compra verificada
                </p>
              {% endif %}
            </div>
            {% render 'rating-stars', rating: review.rating, star_size: 22 %}
            <p class="review-content">{{ review.content | escape }}</p>
            {% if review.images.size > 0 %}
              {% for image in review.images %}<img src="{{ image.url | escape }}" alt="{{ image.alt | default: 'Imagen de la reseña' | escape }}" loading="lazy">{% endfor %}
            {% endif %}
          </article>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="product-reviews__empty">Este producto aún no tiene reseñas.</p>
  {% endif %}
</section>

{% assign resource = data.article %}
{% assign title = resource.seo.title | default: resource.title | append: ' | ' | append: store.name %}
{% assign description = resource.seo.description | default: resource.excerpt | default: store.description | strip_html | strip | truncate: 160 %}
{% metadata title: title, description: description, image: resource.coverImage.url %}
{% head %}
  {% render 'lib/seo/seo-extra', image: resource.coverImage, article: resource %}
  {% render 'lib/seo/structured-page', title: title, description: description, kind: 'WebPage' %}
  {% render './_snippets/structured-article', article: resource, description: description %}
{% endhead %}
{% assign view = './_snippets/template-blog-post-default' %}
{% if resource.template != blank %}{% assign view = './_snippets/template-blog-post-' | append: resource.template %}{% endif %}
{% render view, article: resource, catalog: data.catalog %}

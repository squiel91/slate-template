{% metadata title: 'Blog' %}
<section class="section">
  <h1>Blog</h1>
  {% for post in data.posts.nodes %}
    <article>
      <h2>{% if post.url %}<a href="{{ post.url }}">{{ post.title | escape }}</a>{% else %}{{ post.title | escape }}{% endif %}</h2>
      <p><time datetime="{{ post.publishedAt }}">{{ post.publishedAt | date: '%d/%m/%Y' }}</time></p>
      <p>{{ post.excerpt | escape }}</p>
    </article>
  {% else %}
    <p>Todavía no hay publicaciones.</p>
  {% endfor %}
  {% render 'pagination', info: data.posts.pageInfo, query: request.query %}
</section>

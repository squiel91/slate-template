{% assign product = data.product %}
{% assign title = product.seo.title | default: product.title | append: ' | ' | append: store.name %}
{% assign description = product.seo.description | default: product.description | default: store.description | strip_html | strip | truncate: 160 %}
{% metadata title: title, description: description, image: product.coverImage.url %}
{% head %}
  {{ 'media-carousel.css' | asset_url | stylesheet_tag }}
  {{ 'product.css' | asset_url | stylesheet_tag }}
  {{ 'product.js' | asset_url | script_tag }}
  {% render 'seo-extra', image: product.coverImage %}
  {% render 'structured-page', title: title, description: description %}
  {% render 'structured-product', product: product, description: description %}
{% endhead %}
{% assign related_products = '' | split: ',' %}
{% for collection in product.collections %}
  {% assign related_products = related_products | concat: collection.products.nodes %}
  {% for child in collection.children %}{% assign related_products = related_products | concat: child.products.nodes %}{% endfor %}
{% endfor %}
{% assign candidates = related_products | concat: data.fallback_products.nodes %}
{% assign related_products = '' | split: ',' %}
{% assign candidate_ids = candidates | map: 'id' | uniq %}
{% for candidate_id in candidate_ids %}
  {% assign candidate = candidates | where: 'id', candidate_id | slice: 0, 1 %}
  {% assign related_products = related_products | concat: candidate %}
{% endfor %}
{% assign view = 'template-product-default' %}
{% if product.template != blank %}{% assign view = 'template-product-' | append: product.template %}{% endif %}
{% render view, product: product, related_products: related_products, catalog: data.catalog %}

{% assign product = data.product %}
{% assign title = product.seo.title | default: product.title %}
{% assign description = product.seo.description | default: product.description %}
{% metadata title: title, description: description, image: product.coverImage %}
<article class="section">
  {% assign collection = product.collections.first %}
  {% if collection.url %}<a href="{{ collection.url }}">{{ collection.name | escape }}</a>{% endif %}
  <h1>{{ product.title | escape }}</h1>
  {% for image in product.images %}
    <img src="{{ image | image_url: width: 800 | escape }}" alt="{{ image.alt | escape }}" width="800" {% unless forloop.first %}loading="lazy"{% endunless %}>
  {% endfor %}
  <p>
    {{ product.price | money: product.currency }}
    {% if product.compareAtPrice > product.price %}<s>{{ product.compareAtPrice | money: product.currency }}</s>{% endif %}
  </p>
  {% for option in product.options %}
    <p>{{ option.name | escape }}: {{ option.values | map: 'value' | join: ', ' | escape }}</p>
  {% endfor %}
  {% unless product.available %}<p>Sin stock</p>{% endunless %}
  <div>{{ product.description | escape | newline_to_br }}</div>
  {% if product.specifications.size > 0 %}
    <dl>{% for spec in product.specifications %}<dt>{{ spec.name | escape }}</dt><dd>{{ spec.value | escape }}</dd>{% endfor %}</dl>
  {% endif %}
  {% if product.reviewsCount > 0 %}<p>{{ product.rating | round: 1 }} / 5 ({{ product.reviewsCount }} reseñas)</p>{% endif %}
</article>
{% if collection.products.nodes.size > 1 %}
  <section class="section">
    <h2>También te puede gustar</h2>
    <div class="product-grid">
      {% for related in collection.products.nodes %}
        {% unless related.url == request.path %}{% render 'product-card', product: related %}{% endunless %}
      {% endfor %}
    </div>
  </section>
{% endif %}

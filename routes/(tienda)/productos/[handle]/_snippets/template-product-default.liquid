{% assign variant_images = product.variants | map: 'image' | compact %}
{% assign all_images = product.images | concat: variant_images %}
{% if all_images.size == 0 %}{% assign all_images = product.coverImage | compact %}{% endif %}
{% assign gallery_images = '' | split: ',' %}
{% assign image_urls = all_images | map: 'url' | uniq %}
{% for image_url in image_urls %}
  {% assign image_item = all_images | where: 'url', image_url | slice: 0, 1 %}
  {% assign gallery_images = gallery_images | concat: image_item %}
{% endfor %}
{% assign available_variants = product.variants | where: 'available', true %}
{% assign initial_variant = available_variants | first %}
{% unless initial_variant %}{% assign initial_variant = product.variants | first %}{% endunless %}

{% assign price_cents = product.priceMin | default: product.price %}
{% assign compare_at_cents = product.compareAtPrice %}
{% assign product_currency = product.currency | default: store.currency %}
{% assign stock_message = '' %}
{% if initial_variant.stock == 0 %}
  {% assign stock_message = 'Sin stock' %}
{% elsif initial_variant.stock != nil %}
  {% assign stock_message = initial_variant.stock | append: ' disponibles' %}
{% elsif product.available == false %}
  {% assign stock_message = 'Agotado' %}
{% else %}
  {% assign stock_message = 'Disponible' %}
{% endif %}
{% assign shipping_threshold_cents = 2000 | times: 100 %}

<article
  class="page page-width product"

  data-product-root
  data-analytics-product-title="{{ product.title | escape }}"
  data-product-currency="{{ product_currency | escape }}"
  data-analytics-variant-id="{{ initial_variant.id }}"
  data-analytics-price-in-cents="{{ initial_variant.price | default: price_cents }}"
>
  {% render 'lib/navigation/breadcrumbs', parent_url: catalog.url, parent_label: 'Productos', current_label: product.title %}

  {% assign media_images = gallery_images %}
  {% if media_images.size == 0 and product.coverImage %}
    {% assign media_images = product.images %}
  {% endif %}
  {% assign has_video = false %}
  {% assign video_poster = blank %}
  {% if product.videoUrl != blank %}
    {% assign has_video = true %}
    {% if product.videoUrl contains 'videodelivery.net' or product.videoUrl contains 'cloudflarestream.com' %}
      {% assign stream_path = product.videoUrl | split: '?' | first | split: '/' %}
      {% assign stream_uid = stream_path | last %}
      {% if stream_uid == 'iframe' %}
        {% for segment in stream_path %}
          {% unless forloop.last %}{% assign stream_uid = segment %}{% endunless %}
        {% endfor %}
      {% endif %}
      {% if stream_uid != blank %}
        {% assign video_poster = 'https://videodelivery.net/' | append: stream_uid | append: '/thumbnails/thumbnail.jpg?time=1s&height=320' %}
      {% endif %}
    {% endif %}
  {% endif %}
  {% assign media_count = 0 %}
  {% if media_images.size > 0 %}{% assign media_count = media_images.size %}{% endif %}
  {% if has_video %}{% assign media_count = media_count | plus: 1 %}{% endif %}

  <div class="product__layout">
    {% if media_count == 0 %}
      <div class="product-media" data-product-gallery><img class="product-media__image" src="{{ 'no-image.svg' | asset_url }}" alt="{{ product.title | escape }}"></div>
    {% elsif media_count == 1 %}
      <div class="product-media" data-product-gallery data-media-lightbox-root aria-label="Medios de {{ product.title | escape }}">
        {% if has_video and media_images.size == 0 %}
          <div class="product-media__frame" data-carousel-slide data-slide-type="video" data-video-url="{{ product.videoUrl | escape }}" data-active>
            <div class="media-carousel__video" data-video-host></div>
          </div>
        {% else %}
          {% assign sole_image = media_images | first %}
          {% if sole_image == blank %}{% assign sole_image = product.coverImage %}{% endif %}
          {% if sole_image %}
            <button class="media-carousel__expand" type="button" data-carousel-expand aria-label="Ampliar imagen">
              {% render 'lib/icons/search', size: 18, stroke_width: 1.8 %}
            </button>
            <img
              class="product-media__image"
              src="{{ sole_image.url | escape }}"
              alt="{{ sole_image.alt | default: product.title | escape }}"
              data-image-id="{{ sole_image.url | escape }}"
              data-lightbox-source
            >
            <div class="media-lightbox" data-media-lightbox hidden aria-hidden="true">
              <button class="media-lightbox__backdrop" type="button" data-lightbox-close aria-label="Cerrar imagen ampliada"></button>
              <img class="media-lightbox__image" data-lightbox-image alt="">
              <button class="media-lightbox__close" type="button" data-lightbox-close aria-label="Cerrar">
                {% render 'lib/icons/x', size: 20, stroke_width: 1.7 %}
              </button>
            </div>
          {% endif %}
        {% endif %}
      </div>
    {% elsif media_count > 1 %}
      <section class="media-carousel" data-media-carousel data-product-gallery aria-label="Medios de {{ product.title | escape }}">
        <div class="media-carousel__viewport" data-carousel-viewport>
          <div class="media-carousel__track" data-carousel-track>
            {% for image in media_images %}
              <div class="media-carousel__slide" data-carousel-slide data-slide-type="image" data-image-id="{{ image.url | escape }}">
                <img src="{{ image.url | escape }}" alt="{{ image.alt | default: product.title | escape }}"{% if forloop.first %}{% else %} loading="lazy"{% endif %}>
              </div>
              {% if forloop.first and has_video %}
                <div class="media-carousel__slide" data-carousel-slide data-slide-type="video" data-video-url="{{ product.videoUrl | escape }}">
                  <div class="media-carousel__video" data-video-host></div>
                </div>
              {% endif %}
            {% endfor %}
            {% if media_images.size == 0 and has_video %}
              <div class="media-carousel__slide" data-carousel-slide data-slide-type="video" data-video-url="{{ product.videoUrl | escape }}">
                <div class="media-carousel__video" data-video-host></div>
              </div>
            {% endif %}
          </div>
          <button class="media-carousel__nav media-carousel__nav--prev" type="button" data-carousel-prev aria-label="Anterior">
            {% render 'lib/icons/chevron-left', size: 18, stroke_width: 1.6 %}
          </button>
          <button class="media-carousel__nav media-carousel__nav--next" type="button" data-carousel-next aria-label="Siguiente">
            {% render 'lib/icons/chevron-right', size: 18, stroke_width: 1.6 %}
          </button>
          <button class="media-carousel__expand" type="button" data-carousel-expand aria-label="Ampliar imagen">
            {% render 'lib/icons/search', size: 18, stroke_width: 1.8 %}
          </button>
        </div>
        <div class="media-carousel__thumbs">
          {% for image in media_images %}
            <button
              type="button"
              class="media-carousel__thumb"
              data-carousel-thumb
              data-image-id="{{ image.url | escape }}"
              aria-label="Ver imagen {{ forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            >
              <img src="{{ image.url | escape }}" alt="" loading="lazy">
            </button>
            {% if forloop.first and has_video %}
              <button type="button" class="media-carousel__thumb" data-carousel-thumb aria-label="Ver video">
                {% if video_poster != blank %}
                  <img src="{{ video_poster | escape }}" alt="" loading="lazy"{% if image.url %} onerror="this.onerror=null;this.src='{{ image.url | escape }}'"{% endif %}>
                {% else %}
                  <img src="{{ image.url | escape }}" alt="" loading="lazy">
                {% endif %}
                <span class="media-carousel__thumb-icon">{% render 'lib/icons/play', size: 16, stroke_width: 1.8 %}</span>
              </button>
            {% endif %}
          {% endfor %}
        </div>
        <div class="media-lightbox" data-media-lightbox hidden aria-hidden="true">
          <button class="media-lightbox__backdrop" type="button" data-lightbox-close aria-label="Cerrar imagen ampliada"></button>
          <img class="media-lightbox__image" data-lightbox-image alt="">
          <button class="media-lightbox__close" type="button" data-lightbox-close aria-label="Cerrar">
            {% render 'lib/icons/x', size: 20, stroke_width: 1.7 %}
          </button>
        </div>
      </section>
    {% endif %}

    <div class="product__info">
      <header class="product__header">
        <div class="product__heading">
          <h1>{{ product.title | escape }}</h1>
          <button
            type="button"
            class="wishlist-heart wishlist-heart--product"
            data-action="toggle-wishlist"
            data-product-id="{{ product.id }}"
            aria-pressed="false"
            aria-label="Guardar en favoritos"
          >
            {% render 'lib/icons/heart', size: 22, stroke_width: 1.8 %}
          </button>
        </div>
        {% render 'lib/ui/rating-stars', rating: product.rating, count: product.reviewsCount, star_size: 22 %}
      </header>

      {% if price_cents != blank %}
        <p class="product__price" aria-live="polite">
          <s data-product-compare-price{% unless compare_at_cents != blank and compare_at_cents > price_cents %} hidden{% endunless %}>{% if compare_at_cents != blank %}{{ compare_at_cents | money: product_currency }}{% endif %}</s>
          <strong data-product-price>{% if product.priceMax > product.priceMin %}Desde {% endif %}{{ price_cents | money: product_currency }}</strong>
        </p>
      {% endif %}

      <p class="product__stock" data-product-stock role="status">{{ stock_message | escape }}</p>

      {% if price_cents != blank and price_cents >= shipping_threshold_cents %}
        <p class="product__note">Alcanza el mínimo de envío gratis.</p>
      {% endif %}

      {% if product.variants.size > 0 %}
        <form class="product__form" data-product-form>
          {% if product.options.size > 0 %}
            <div data-attribute-groups>
              {% for attribute in product.options %}
                {% assign selected_value_id = blank %}
                {% for selected in initial_variant.selectedOptions %}
                  {% if selected.name == attribute.name %}{% assign selected_value_id = selected.value %}{% endif %}
                {% endfor %}
                <fieldset data-attribute-group data-attribute-id="{{ attribute.name | url_encode }}">
                  <legend>{{ attribute.name | escape }}</legend>
                  {% if attribute.displayType == 'radio' %}
                    <div data-attribute-options>
                      {% for value in attribute.values %}
                        <label data-attribute-option>
                          <input
                            type="radio"
                            name="attribute_{{ attribute.name | url_encode }}"
                            value="{{ value.value | url_encode }}"
                            data-attribute-input
                            data-attribute-id="{{ attribute.name | url_encode }}"
                            data-value-id="{{ value.value | url_encode }}"
                            data-value-label="{{ value.value | escape }}"
                            data-value-color="{{ value.color | escape }}"
                            data-value-image-url="{% if value.image %}{{ value.image.url | escape }}{% endif %}"
                            {% if value.value == selected_value_id %}checked{% endif %}
                          >
                          {% if value.image %}
                            <img data-option-image src="{{ value.image.url | escape }}" alt="" loading="lazy">
                          {% elsif value.color != blank %}
                            <span data-option-swatch style="--option-color: {{ value.color | escape }}"></span>
                          {% endif %}
                          <span>{{ value.value | escape }}</span>
                        </label>
                      {% endfor %}
                    </div>
                  {% else %}
                    <select
                      id="product-attribute-{{ attribute.name | url_encode }}-main-product"
                      name="attribute_{{ attribute.name | url_encode }}"
                      data-attribute-input
                      data-attribute-id="{{ attribute.name | url_encode }}"
                      aria-label="{{ attribute.name | escape }}"
                    >
                      {% for value in attribute.values %}
                        <option
                          value="{{ value.value | url_encode }}"
                          data-value-id="{{ value.value | url_encode }}"
                          data-value-label="{{ value.value | escape }}"
                          data-value-color="{{ value.color | escape }}"
                          data-value-image-url="{% if value.image %}{{ value.image.url | escape }}{% endif %}"
                          {% if value.value == selected_value_id %}selected{% endif %}
                        >{{ value.value | escape }}</option>
                      {% endfor %}
                    </select>
                    <span data-attribute-preview aria-live="polite">
                      <span data-attribute-preview-swatch hidden></span>
                      <img data-attribute-preview-image alt="" hidden>
                      <span data-attribute-preview-label></span>
                    </span>
                  {% endif %}
                </fieldset>
              {% endfor %}
            </div>

            <select name="variant_id" data-variant-select hidden aria-hidden="true" tabindex="-1">
              {% for variant in product.variants %}
                {% capture variant_attribute_map %}{% for selected in variant.selectedOptions %}{{ selected.name | url_encode }}:{{ selected.value | url_encode }}{% unless forloop.last %};{% endunless %}{% endfor %}{% endcapture %}
                {% capture variant_label %}{% for selected in variant.selectedOptions %}{{ selected.name }}: {{ selected.value }}{% unless forloop.last %} / {% endunless %}{% endfor %}{% endcapture %}
                <option
                  value="{{ variant.id }}"
                  data-attribute-value-map="{{ variant_attribute_map }}"
                  data-price-in-cents="{{ variant.price | default: price_cents }}"
                  data-compare-at-price-in-cents="{{ variant.compareAtPrice }}"
                  data-stock="{{ variant.stock }}"
                  {% if variant.image %}
                    data-cover-image-id="{{ variant.image.url }}"
                    data-cover-image-url="{{ variant.image.url | escape }}"
                    data-cover-image-alt="{{ variant.image.alt | default: product.title | escape }}"
                  {% endif %}
                  {% if variant.id == initial_variant.id %}selected{% endif %}
                  {% if variant.available == false %}disabled{% endif %}
                >{{ variant_label | strip | default: variant.sku | default: 'Opción' | escape }}{% if variant.stock == 0 %} — agotada{% endif %}</option>
              {% endfor %}
            </select>
          {% elsif product.variants.size > 1 %}
            <label for="product-variant-main-product">Opción</label>
            <select id="product-variant-main-product" name="variant_id" data-variant-select>
              {% for variant in product.variants %}
                {% capture variant_label %}{% for selected in variant.selectedOptions %}{{ selected.name }}: {{ selected.value }}{% unless forloop.last %} / {% endunless %}{% endfor %}{% endcapture %}
                <option
                  value="{{ variant.id }}"
                  data-price-in-cents="{{ variant.price | default: price_cents }}"
                  data-compare-at-price-in-cents="{{ variant.compareAtPrice }}"
                  data-stock="{{ variant.stock }}"
                  {% if variant.image %}
                    data-cover-image-id="{{ variant.image.url }}"
                    data-cover-image-url="{{ variant.image.url | escape }}"
                    data-cover-image-alt="{{ variant.image.alt | default: product.title | escape }}"
                  {% endif %}
                  {% if variant.id == initial_variant.id %}selected{% endif %}
                  {% if variant.available == false %}disabled{% endif %}
                >{{ variant_label | strip | default: variant.sku | default: 'Opción' | escape }}{% if variant.stock == 0 %} — agotada{% endif %}</option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="variant_id" value="{{ initial_variant.id }}">
          {% endif %}

          <div class="quantity">
            <label for="product-quantity-main-product">Cantidad</label>
            <button type="button" data-quantity-decrease aria-label="Disminuir cantidad">{% render 'lib/icons/minus', size: 16, stroke_width: 1.7 %}</button>
            <input id="product-quantity-main-product" type="number" name="quantity" value="1" min="1" step="1"{% if initial_variant.stock != blank %} max="{{ initial_variant.stock }}"{% endif %}>
            <button type="button" data-quantity-increase aria-label="Aumentar cantidad">{% render 'lib/icons/plus', size: 16, stroke_width: 1.7 %}</button>
          </div>

          <button
            class="button"
            type="submit"
            data-action="add-to-cart"
            data-variant-id="{{ initial_variant.id }}"
            data-product-title="{{ product.title | escape }}"
            data-product-currency="{{ product_currency | escape }}"
            data-price-in-cents="{{ initial_variant.price | default: price_cents }}"
            {% if product.available == false %}disabled{% endif %}
          >{% if product.available == false %}Agotado{% else %}Agregar al carrito{% endif %}</button>
          <p role="alert" data-product-error hidden></p>
        </form>
      {% else %}
        <p class="product__note">Este producto no tiene opciones disponibles.</p>
      {% endif %}

      <button class="share-button" type="button" data-action="share" data-share-title="{{ product.title | escape }}">
        Compartir
        {% render 'lib/icons/forward', size: 16, stroke_width: 1.6 %}
      </button>
    </div>
  </div>
</article>


{% render './product-description', product: product %}
{% render './product-reviews', product: product %}
{% render './related-products', products: related_products, product_id: product.id %}

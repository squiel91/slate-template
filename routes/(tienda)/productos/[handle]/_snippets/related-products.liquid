{% assign shown = 0 %}
{% capture cards %}
  {% for related in products %}
    {% if related.id != product_id and shown < 4 %}
      <li>{% render 'lib/product-card', product: related %}</li>
      {% assign shown = shown | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endcapture %}
{% if shown > 0 %}
  <section class="section" data-animate-in aria-labelledby="related-heading">
    <div class="page-width">
      <div class="section-header"><h2 class="section-title" id="related-heading">También te puede interesar</h2></div>
      <ul class="product-grid">{{ cards }}</ul>
    </div>
  </section>
{% endif %}

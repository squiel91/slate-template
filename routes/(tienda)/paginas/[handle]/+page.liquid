{% assign resource = data.page %}
{% assign title = resource.seo.title | default: resource.title | append: ' | ' | append: store.name %}
{% assign description = resource.seo.description | default: resource.seo.description | default: store.description | strip_html | strip | truncate: 160 %}
{% metadata title: title, description: description, image: resource.coverImage.url %}
{% head %}
  {% render 'lib/seo/seo-extra', image: resource.coverImage, article: nil %}
  {% render 'lib/seo/structured-page', title: title, description: description, kind: 'WebPage' %}

{% endhead %}
{% assign view = './_snippets/template-page-default' %}
{% if resource.template != blank %}{% assign view = './_snippets/template-page-' | append: resource.template %}{% endif %}
{% render view, page: resource, catalog: data.catalog %}

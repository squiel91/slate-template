{% metadata title: store.name, description: store.description %}
{% head %}
  {% render 'structured-page', title: store.name, description: store.description %}
  {{ 'hero-carousel.js' | asset_url | script_tag }}
{% endhead %}
{% render 'hero-carousel', catalog: data.catalog, decoration: data.decoration %}
{% render 'featured-collections', collections: data.featured_collections, catalog: data.featured %}
{% render 'featured-products', collection: data.featured %}
{% render 'split-feature', collection: data.editorial %}
{% render 'highlights' %}
{% render 'testimonials' %}
{% render 'featured-blog', posts: data.posts.nodes %}
{% render 'newsletter' %}

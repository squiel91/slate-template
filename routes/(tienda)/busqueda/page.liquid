{% capture title %}Resultados para "{{ request.query.q }}" | {{ store.name }}{% endcapture %}
{% metadata title: title, robots: 'noindex,follow' %}
{% head %}{% render 'structured-page', title: 'Búsqueda', kind: 'SearchResultsPage' %}{% endhead %}
<section class="page page-width">
    {% render 'breadcrumbs', current_label: 'Búsqueda' %}
    <header class="page-header">
      <h1>Buscar</h1>
    </header>

    <div class="search-panel">
      <form action="/busqueda" method="get" role="search">
        <label class="visually-hidden" for="search-page-main-search">Buscar productos</label>
        <input id="search-page-main-search" class="field" type="search" name="q" value="{{ request.query.q | escape }}" placeholder="¿Qué estás buscando?" autofocus>
        <button class="button" type="submit">Buscar</button>
      </form>
    </div>

    {% if request.query.q != blank %}
      <p class="search-count">{{ data.results.totalCount }} {% if data.results.totalCount == 1 %}resultado{% else %}resultados{% endif %} para “{{ request.query.q | escape }}”.</p>

        {% if data.results.totalCount > 0 %}
          <ul class="product-grid">
            {% for product in data.results.nodes %}
              <li>{% render 'product-card', product: product %}</li>
            {% endfor %}
          </ul>
          {% render 'pagination', info: data.results.pageInfo, query: request.query %}
        {% else %}
          <div class="empty-state">
            <p>No se encontraron productos.</p>
            <a class="button" href="{{ data.catalog.url | escape }}">Ver el catálogo</a>
          </div>
        {% endif %}

    {% endif %}
</section>

{%- comment -%}
  Finite two-slide carousel. Slide copy and images default in the schema.
{%- endcomment -%}
{% assign slide_1_image_url = 'http://localhost:8787/imagedelivery/local/cdfd1faa-a3ef-4b2b-acce-23522c816e4e/lg' | default: 'http://localhost:8787/imagedelivery/local/cdfd1faa-a3ef-4b2b-acce-23522c816e4e/lg' %}
{% assign slide_2_image_url = 'http://localhost:8787/imagedelivery/local/519af17c-23a9-4612-92a1-7247edc3bd40/lg' | default: 'http://localhost:8787/imagedelivery/local/519af17c-23a9-4612-92a1-7247edc3bd40/lg' %}
{% assign heading_tag = 'h2' %}
{% if 'h1' == 'h1' %}{% assign heading_tag = 'h1' %}{% endif %}

{% assign decoration_url = decoration.url | default: catalog.url %}
<section
  class="hero-carousel"

  data-hero-carousel
  data-autoplay="{{ 'true' | default: 'true' | escape }}"
  data-autoplay-ms="{{ 5500 | default: 5500 | escape }}"
  tabindex="0"
  aria-roledescription="carrusel"
  aria-label="{{ 'Destacados' | default: 'Destacados' | escape }}"
>
  <div class="hero-carousel__viewport" data-carousel-viewport>
    <div class="hero-carousel__track" data-carousel-track>
      <article class="hero-carousel__slide" data-carousel-slide data-active>
        {% if slide_1_image_url != blank %}
          <div class="hero-carousel__media">
            <img
              src="{{ slide_1_image_url | image_url: width: 1800 | escape }}"
              alt="{{ '' | default: '' | escape }}"
              fetchpriority="high"
            >
          </div>
        {% endif %}
        <div class="hero-carousel__content page-width">
          {% if heading_tag == 'h1' %}
            <h1 id="hero-heading-hero-carousel">{{ '' | default: store.name | escape }}</h1>
          {% else %}
            <h2 id="hero-heading-hero-carousel">{{ '' | default: store.name | escape }}</h2>
          {% endif %}
          {% if 'Una selección cuidada, pensada para acompañar el día a día.' != blank %}
            <p>Una selección cuidada, pensada para acompañar el día a día.</p>
          {% endif %}
          {% if 'Ver el catálogo' != blank and catalog.url != blank %}
            <a class="button button--light" href="/categorias/todas">
              Ver el catálogo
              {% render 'lib/icons/arrow-right', size: 16, stroke_width: 1.7 %}
            </a>
          {% endif %}
        </div>
      </article>

      <article class="hero-carousel__slide" data-carousel-slide aria-hidden="true">
        {% if slide_2_image_url != blank %}
          <div class="hero-carousel__media">
            <img
              src="{{ slide_2_image_url | image_url: width: 1800 | escape }}"
              alt="{{ '' | default: 'Objetos para el espacio' | escape }}"
              loading="lazy"
            >
          </div>
        {% endif %}
        <div class="hero-carousel__content page-width">
          <h2>Objetos para el espacio</h2>
          {% if 'Piezas de cerámica para dar calor y carácter a cada rincón de la casa.' != blank %}
            <p>Piezas de cerámica para dar calor y carácter a cada rincón de la casa.</p>
          {% endif %}
          {% if 'Ver decoración' != blank and decoration_url != blank %}
            <a class="button button--light" href="/categorias/decoracion">
              Ver decoración
              {% render 'lib/icons/arrow-right', size: 16, stroke_width: 1.7 %}
            </a>
          {% endif %}
        </div>
      </article>
    </div>
  </div>

  <div class="hero-carousel__dots" role="group" aria-label="Diapositivas">
    <button
      type="button"
      class="hero-carousel__dot"
      data-carousel-dot
      aria-current="true"
      aria-label="Ir a la diapositiva 1"
    ></button>
    <button
      type="button"
      class="hero-carousel__dot"
      data-carousel-dot
      aria-label="Ir a la diapositiva 2"
    ></button>
  </div>
</section>

<section class="section" data-animate-in aria-labelledby="featured-blog-heading">
  <div class="page-width">
    <div class="section-header">
      <div><span class="section-kicker">Lectura</span><h2 class="section-title" id="featured-blog-heading">Blog</h2></div>
      <a class="text-link" href="/blog">Ver todos {% render 'lib/icons/arrow-right', size: 16, stroke_width: 1.7 %}</a>
    </div>
    <div data-blog-preview-list>
      {% for post in posts %}
        {% if forloop.first %}
          <article class="article-card article-card--featured">
            <a class="article-card__media media" href="{{ post.url | escape }}">
              {% if post.coverImage %}<img class="media__img" src="{{ post.coverImage.url | escape }}" alt="{{ post.coverImage.alt | default: post.title | escape }}" loading="lazy">{% endif %}
            </a>
            <div class="article-card__copy">
              <span class="section-kicker">Último post</span>
              <a href="{{ post.url | escape }}"><h3 class="article-card__title">{{ post.title | escape }}</h3></a>
              <div class="article-card__meta">
                {% if post.excerpt != blank %}<p>{{ post.excerpt | escape }}</p>{% endif %}
                {% render 'lib/article-byline', author: store.name, datetime: post.publishedAt %}
              </div>
            </div>
          </article>
        {% endif %}
      {% else %}<p class="empty-state">No hay artículos publicados.</p>{% endfor %}
      {% if posts.size > 1 %}
        <div class="article-grid">
          {% for post in posts offset: 1 %}
            <article class="article-card">
              <a href="{{ post.url | escape }}"><span class="media media--wide">{% if post.coverImage %}<img class="media__img" src="{{ post.coverImage.url | escape }}" alt="{{ post.coverImage.alt | default: post.title | escape }}" loading="lazy">{% endif %}</span><h3 class="article-card__title">{{ post.title | escape }}</h3></a>
              <div class="article-card__meta">{% if post.excerpt != blank %}<p>{{ post.excerpt | escape }}</p>{% endif %}{% render 'lib/article-byline', author: store.name, datetime: post.publishedAt %}</div>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
